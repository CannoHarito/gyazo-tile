{
  "name": "Gyazo Tile",
  "short_name": "GyazoTile",
  "start_url": "/",
  "display": "standalone",
  "background_color": "#efedea",
  "icons": [
    { "src": "/maskable.svg", "purpose": "maskable" },
    { "src": "/favicon.ico", "sizes": "any", "type": "image/svg+xml" }
  ],
  "scope": "/",
  "share_target": {
    "action": "/sw/inbox",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": { "files": [{ "name": "imageData[]", "accept": ["image/*"] }] }
  }
}
